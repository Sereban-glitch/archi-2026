# ============================================================
# archi-ear.service — hands-free слушатель «Арчи, …» (ноутбук)
#
# ⚠️ ГЛАВНАЯ ПРИЧИНА «НЕ СЛЫШИТ»: PipeWire/PulseAudio живут в СЕССИИ
# пользователя, а системный юнит её не видит — дефолтный микрофон
# недоступен. Ниже уже прописан Environment=XDG_RUNTIME_DIR=/run/user/1000
# (uid первого пользователя Linux Mint; проверь свой: id -u).
# Если не заработает — запускай юнитом ПОЛЬЗОВАТЕЛЯ (archi-ear-user.service),
# это самый надёжный путь на ноутбуке.
#
# Отдельный процесс от основного демона: микрофонный цикл не умирает
# при рестарте archi, а неудача слушателя не роняет агента.
# Требует: ear.enabled=true, ipc.enabled=true, voice.stt.enabled=true
# и доступ к /run/archi/archi.sock. Диагностика: archi ear --test.
#
# Установка:
#   sudo cp archi-ear.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now archi-ear
#   journalctl -u archi-ear -f     — смотреть, что слышит агент
# ============================================================

[Unit]
Description=Archi 2026 — hands-free слушатель (wake-word «Арчи», VAD, STT)
Documentation=file:///home/archi/archi/README.md
After=network-online.target archi.service
Wants=network-online.target
Requires=archi.service

[Service]
Type=simple
User=archi
Group=archi

# Доступ к сессии PipeWire пользователя (uid 1000 — первый пользователь Mint;
# проверь: id -u). Без этой строки микрофон через дефолтное устройство недоступен!
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Если сокет PipeWire закрыт для чужого пользователя — либо добавь archi
# в группу владельца сокета, либо задай ear.device=plughw:... (arecord -L),
# либо переходи на archi-ear-user.service (юнит пользователя).

ExecStart=/usr/local/bin/archi ear --config /etc/archi/config.yaml
ExecReload=/bin/kill -HUP $MAINPID

# Слушателю нужен доступ к аудио-устройству, IPC-сокету демона и сокету
# сессии PipeWire (подключение к сокету = запись в него).
SupplementaryGroups=audio
ReadWritePaths=/run/archi /run/user/1000

Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Ресурсы: VAD лёгкий, но потолок не помешает.
MemoryMax=256M
CPUWeight=30

LimitNOFILE=4096
TasksMax=32

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

EnvironmentFile=-/etc/archi/archi.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=archi-ear

[Install]
WantedBy=multi-user.target
