# ============================================================
# archi-tunnel.service — SSH-туннель к antigravity-прокси на VM
# Пробрасывает 127.0.0.1:18080 (ноутбук) → 127.0.0.1:18080 (VM),
# чтобы archicore ходил на LLM-прокси как на localhost.
#
#   sudo cp archi-tunnel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now archi-tunnel
# ============================================================

[Unit]
Description=Archi — SSH-туннель к antigravity-claude-proxy (agrobot-prod:18080)
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=archi

# -N: без команды, -T: без TTY, ServerAliveInterval держит NAT открытым,
# ExitOnForwardFailure — не стартуем, если порт не пробросился.
ExecStart=/usr/bin/ssh -N -T \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=4 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=yes \
  -L 127.0.0.1:18080:127.0.0.1:18080 \
  agrobot-prod
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10

Nice=5

[Install]
WantedBy=multi-user.target
